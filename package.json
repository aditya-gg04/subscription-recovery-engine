{
  "name": "recovery-agent",
  "version": "1.0.0",
  "description": "Failed-payment / subscription revenue recovery agent for Razorpay",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-data": "tsx generate-synthetic-events.ts",
    "run-batch": "tsx src/runBatch.ts",
    "server": "tsx src/server.ts",
    "dashboard:dev": "cd dashboard && npm run dev"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "groq-sdk": "^0.8.0",
    "js-yaml": "^4.1.0",
    "razorpay": "^2.9.8",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
